<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MyAdv License Manager"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="Not configured" />

        <TextView
            android:id="@+id/txtRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ROLE"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mobile number"
            android:inputType="phone"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnActivateManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVATE LICENSE MANAGER" />

        <TextView
            android:id="@+id/txtAdminLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Admin: paste the Admin license package below"
            android:paddingTop="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAdminPackage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="License No + signed token"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnActivateAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVATE AS ADMIN" />

        <TextView
            android:id="@+id/txtCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CREATE LICENSE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp" />

        <Spinner
            android:id="@+id/spnRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/edtTargetPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Advocate/Admin mobile number"
            android:inputType="phone"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry YYYY-MM-DD"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CREATE LICENSE"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGenerated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No license created yet."
            android:textIsSelectable="true"
            android:padding="14dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE LICENSE" />

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:paddingTop="18dp"
            android:text="Offline manager. No signing-key file or signing password is required. The signing authority is used internally by this app." />
    </LinearLayout>
</ScrollView>

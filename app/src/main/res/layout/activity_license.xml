<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/txtLicenseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MyAdv License Center"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtLicenseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline license activation."
            android:alpha="0.7"
            android:paddingTop="6dp"
            android:paddingBottom="16dp" />
        <TextView
            android:id="@+id/txtAdminKeyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Signing key: NOT CONFIGURED"
            android:textStyle="bold"
            android:padding="12dp" />
        <EditText
            android:id="@+id/edtAdminPrivateKey"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="One-time setup: paste administrator PKCS#8 private key"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:visibility="visible" />
        <Button
            android:id="@+id/btnSaveAdminKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURELY SAVE SIGNING KEY" />
        <TextView
            android:id="@+id/txtAdminKeyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The private key is encrypted with Android Keystore on this device. It is never compiled into the APK."
            android:alpha="0.7"
            android:paddingTop="6dp"
            android:paddingBottom="18dp" />
        <TextView
            android:id="@+id/txtGenerateSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERATE LICENSE"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edtGeneratePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone number"
            android:inputType="phone"
            android:singleLine="true"
            android:layout_marginTop="10dp" />
        <Spinner
            android:id="@+id/spnGenerateRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/edtGenerateExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date (YYYY-MM-DD)"
            android:inputType="date"
            android:singleLine="true" />
        <Button
            android:id="@+id/btnGenerateLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERATE LICENSE"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtGeneratedLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No license generated yet."
            android:textIsSelectable="true"
            android:padding="14dp"
            android:background="#EEEEEE"
            android:layout_marginTop="10dp" />
        <Button
            android:id="@+id/btnShareGenerated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE LICENSE" />
        <TextView
            android:id="@+id/txtInstallSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSTALL LICENSE ON THIS DEVICE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp" />
        <TextView
            android:id="@+id/txtLicenseDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: NOT ACTIVATED"
            android:textStyle="bold"
            android:padding="14dp"
            android:background="#EEEEEE"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/edtLicenseId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="License ID (e.g. ANI7-X4P9-M2Q8-T6R3)"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/edtSignedToken"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Signed license token"
            android:gravity="top|start"
            android:inputType="textMultiLine" />
        <Button
            android:id="@+id/btnActivateLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVATE LICENSE"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnClearLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR INSTALLED LICENSE" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F5F7FA">

    <ImageView
        android:id="@+id/imgLoginAppIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/kba_icon"
        android:contentDescription="MyAdv app icon"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtLoginTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MyAdv"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1769E0"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtLoginMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtLoginDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:alpha="0.7"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/edtUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="User ID / Phone Number"
        android:inputType="phone"
        android:singleLine="true"
        android:padding="14dp" />

    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Create Password"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:singleLine="true"
        android:padding="14dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="CREATE LOGIN &amp; CONTINUE"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnLicense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="INSTALL / CHANGE LICENSE" />

</LinearLayout>

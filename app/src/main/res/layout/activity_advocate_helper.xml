<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/helperScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Advocate Helper" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Case, hearing, client and fee management" android:alpha="0.7" android:paddingBottom="8dp" />

        <TextView android:id="@+id/headerDashboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  DASHBOARD" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" />
        <LinearLayout android:id="@+id/sectionDashboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#EEEEEE"><TextView android:id="@+id/txtTotalCases" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Cases"/></LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="1dp"/><LinearLayout android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#EEEEEE"><TextView android:id="@+id/txtTodayHearings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today's Hearings"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#EEEEEE"><TextView android:id="@+id/txtUpcomingHearings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming"/></LinearLayout>
                <Space android:layout_width="6dp" android:layout_height="1dp"/><LinearLayout android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#EEEEEE"><TextView android:id="@+id/txtPendingFees" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending Fees"/></LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/txtLicenseStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="License: Checking..." android:textStyle="bold" android:padding="8dp" android:layout_marginTop="6dp"/>
            <Button android:id="@+id/btnReminderSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HEARING REMINDER SETTINGS"/>
            <Button android:id="@+id/btnBackupRestore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BACKUP &amp; RESTORE" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/headerCaseDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  CASE DETAILS" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/sectionCaseDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edtCaseNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Case Number *" android:singleLine="true"/>
            <EditText android:id="@+id/edtClientName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Client Name *" android:inputType="textCapWords" android:singleLine="true"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/edtClientPhone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Client Phone" android:inputType="phone" android:singleLine="true"/>
                <Button android:id="@+id/btnImportClientPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMPORT"/>
            </LinearLayout>
            <EditText android:id="@+id/edtCourtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Court" android:inputType="textCapWords" android:singleLine="true"/>
            <Button android:id="@+id/btnOpenDiary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPEN ADVOCATE DIARY" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/headerHearing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  HEARING DATES" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/sectionHearing" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edtPreviousDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Previous Date" android:focusable="false" android:clickable="true"/>
            <EditText android:id="@+id/edtCurrentDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Current / Hearing Date" android:focusable="false" android:clickable="true"/>
            <EditText android:id="@+id/edtNextDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Next Date" android:focusable="false" android:clickable="true"/>
            <Button android:id="@+id/btnSendNextDateMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MESSAGE CLIENT ABOUT NEXT DATE"/>
        </LinearLayout>

        <TextView android:id="@+id/headerCaseUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  CASE UPDATE / REMARK" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/sectionCaseUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edtCurrentUpdate" android:layout_width="match_parent" android:layout_height="82dp" android:gravity="top|start" android:hint="Current Update" android:inputType="textMultiLine"/>
            <EditText android:id="@+id/edtNewUpdate" android:layout_width="match_parent" android:layout_height="82dp" android:gravity="top|start" android:hint="New Update / Remark" android:inputType="textMultiLine"/>
        </LinearLayout>

        <TextView android:id="@+id/headerFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  FEE TRACKING" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/sectionFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edtTotalFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Total Fee" android:inputType="numberDecimal" android:singleLine="true"/>
            <EditText android:id="@+id/edtAmountReceived" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Amount Received" android:inputType="numberDecimal" android:singleLine="true"/>
            <TextView android:id="@+id/txtCurrentBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Balance: ₹0" android:textStyle="bold" android:padding="8dp"/>
            <Button android:id="@+id/btnPaymentReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MESSAGE CLIENT FOR PAYMENT"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnSaveCase" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SAVE CASE" android:textStyle="bold"/>
                <Space android:layout_width="8dp" android:layout_height="1dp"/>
                <Button android:id="@+id/btnClearForm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CLEAR FORM"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/headerSavedCases" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▼  SAVED CASES" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/sectionSavedCases" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edtCaseSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search case, client, phone or court" android:singleLine="true"/>
            <TextView android:id="@+id/txtEmptyCases" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No cases saved yet." android:gravity="center" android:padding="16dp" android:alpha="0.65"/>
            <com.example.kbawelfaremessenger.ScrollableContactRecyclerView android:id="@+id/recyclerCases" android:layout_width="match_parent" android:layout_height="320dp" android:nestedScrollingEnabled="true" android:overScrollMode="ifContentScrolls"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

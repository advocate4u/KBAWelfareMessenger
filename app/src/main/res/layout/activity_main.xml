<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KBA Welfare Messenger"
            android:textColor="#163968"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="CSV • Multiple numbers • SMS scheduling • WhatsApp"
            android:textColor="#687586"
            android:textSize="13sp"/>

    </LinearLayout>


    <!-- CSV section -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="UPLOAD CSV"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No file selected"
            android:textColor="#52606D"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="People: 0 | Individual numbers: 0"
            android:textColor="#163968"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- Search -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Search name or mobile number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textSize="15sp"/>

    </LinearLayout>


    <!-- Selection controls -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp">

        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="SELECT ALL"
            android:textSize="12sp"/>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnUnselectAll"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="UNSELECT ALL"
            android:textSize="12sp"/>

    </LinearLayout>


    <TextView
        android:id="@+id/txtSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="Selected: 0 / 0"
        android:textColor="#163968"
        android:textSize="14sp"
        android:textStyle="bold"/>


    <!-- Contact list -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"/>


    <!-- Bottom actions -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MESSAGE"
                android:textColor="#163968"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtMessage"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:gravity="top|start"
                android:hint="Dear {{Name}},&#10;&#10;Your message..."
                android:inputType="textMultiLine"
                android:padding="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Placeholders: {{Name}}   {{MobileNumber}}"
                android:textColor="#687586"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnSaveDraft"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:text="SAVE DRAFT"/>

            <Button
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="PREVIEW SELECTED"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SMS"
                android:textColor="#163968"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnTestSms"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="TEST SMS — FIRST SELECTED"/>

            <Button
                android:id="@+id/btnSendSms"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="SEND SMS NOW"/>

            <Button
                android:id="@+id/btnSchedule"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="SCHEDULE SMS"/>

            <Button
                android:id="@+id/btnCancelSchedule"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="CANCEL SCHEDULED SMS"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="WHATSAPP"
                android:textColor="#163968"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="OPEN WHATSAPP — NEXT SELECTED"/>


            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:text="RESET SELECTION / SEARCH"/>

            <Button
                android:id="@+id/btnClearData"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="REMOVE CSV / CLEAR CONTACTS"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Ready"
                android:textColor="#52606D"
                android:textSize="13sp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtStats"
            android:text="People: 0 | Individual numbers: 0"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtSearch"
            android:hint="Search name or number"
            android:singleLine="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/edtFrom"
                android:hint="From"
                android:text="1"
                android:inputType="number"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/edtTo"
                android:hint="To"
                android:text="100"
                android:inputType="number"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:text="Message Draft"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtMessage"
            android:gravity="top|start"
            android:minHeight="150dp"
            android:inputType="textMultiLine"
            android:hint="Dear {{Name}},&#10;&#10;Your message..."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Placeholders: {{Name}}  {{MobileNumber}}"
            android:textSize="12sp"
            android:textColor="#657184"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button android:id="@+id/btnSaveDraft" android:text="Save Draft"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnPreview" android:text="Preview First 5"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnTestSms" android:text="Test SMS (first number)"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnSendSms" android:text="Send SMS Now"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnSchedule" android:text="Schedule SMS"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnCancelSchedule" android:text="Cancel Scheduled SMS"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnWhatsApp" android:text="Open WhatsApp — Next Contact"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView
            android:text="Actions / Filters"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button android:id="@+id/btnReset" android:text="Reset Actions / Filters"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnClearData" android:text="Remove CSV / Clear Stored Contacts"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtStatus"
            android:text="Ready"
            android:paddingTop="12dp"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="CSV columns required: OriginalName and MobileNumber. Multiple numbers are split into individual contacts and duplicates are removed. SMS delivery depends on Android/SIM/carrier restrictions."
            android:textSize="12sp"
            android:textColor="#657184"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
